# Warden AI Environment Variables (Optional)
# In Warden AI, API keys are primarily configured directly by users in Settings (BYOK).
# These server/build environment variables can optionally be provided for self-hosting.

# GEMINI_API_KEY: Default Google Gemini API key
GEMINI_API_KEY=""

# APP_URL: Optional root application URL for local proxy and callbacks
APP_URL="http://localhost:3000"
